{
    "ConnectionStrings": {
        "AppContext": "Data Source=app.db"
    },
    "PeerSync": {
        "PublicUrl": "http://localhost:5011",
        "PollIntervalSeconds": 30
    },
    "ErasureCoding": {
        "DataShards": 2,
        "ParityShards": 1,
        "RepairIntervalSeconds": 60,
        "RepairBatchSize": 50
    },
    "MessageRequests": {
        "MaxMessagesPerRequest": 0
    },
    "RateLimiting": {
        "PermitLimit": 20,
        "WindowSeconds": 60
    }
}
