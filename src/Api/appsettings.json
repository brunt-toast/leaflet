{
    "ConnectionStrings": {
        "AppContext": "Data Source=app.db"
    },
    "ApplicationLogging": {
        "SqliteDbPath": "logs/api-logs.db",
        "MinimumLevel": "Information",
        "MicrosoftMinimumLevel": "Warning"
    },
    "PeerSync": {
        "PublicUrl": "http://localhost:5011",
        "PollIntervalSeconds": 30
    },
    "ErasureCoding": {
        "DataShards": 2,
        "ParityShards": 1,
        "RepairIntervalSeconds": 60,
        "RepairBatchSize": 50
    },
    "MessageRequests": {
        "MaxMessagesPerRequest": 0,
        "MaxMessageContentBytes": 2000
    },
    "RateLimiting": {
        "PermitLimit": 20,
        "WindowSeconds": 60
    }
}
